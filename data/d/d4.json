","https://d1774jszgerdmk.cloudfront.net/1024/9680b0f7-1e1d-4404-866c-80062a53593c","https://d1774jszgerdmk.cloudfront.net/1024/fa922720-8064-440e-8c65-dae0198cc150"],"facts":[["Exclusive size","59.99 m²"],["Supply size","78.18 m²"],["Rooms",3],["Bathrooms",2],["Floor","8층 of 25층"],["Facing","남서"],["Layout","복도식"],["Parking","가능, 1.06 per unit"],["Move in","즉시 입주"],["Maintenance","18만원"],["Approved","2005.06.30"],["Households",2105],["Posted","2026.10.28"]],"opts":[],"tags":["주차"],"near":[["서울구암초등학교","157 m"],["무릎학교어린이집","251 m"],["서울은천초등학교병설유치원","369 m"],["구암중학교","483 m"]],"link":["Dabang","https://dabangapp.com/room/6ae153b374252020c89c7642"],"station":["봉천역 (2호선)","842 m"]},"d:6acf35027e3dd10adb9fa64c":{"memo":"*한강 조망과 특올수리 공간\n한강 조망이 가능한 로얄층 매물로 내부를 특올수리하여 아주 깔끔해요. 전용 114.87㎡의 넓은 면적에 방 4개와 욕실 2개로 구성되어 가족 단위로 거주하기 참 좋답니다.\n\n*쾌적한 자연과 생활 인프라\n한강시민공원이 가까워 산책과 운동을 즐기기에 최적의 환경이에요. 인근 암사종합시장에서 신선한 먹거리를 편리하게 구입할 수 있어 생활이 무척 풍요롭답니다.\n\n*8호선 암사역 역세권 생활\n8호선 암사역을 도보 10분 내외로 이용할 수 있어 교통이 편리해요. 단지 인근에 선사초등학교가 있어 아이들의 등하교도 수월한 편이랍니다.\n\n*보증금 10억 전세 조건\n현재 전세 10억 원으로 진행 중이며, 정상입주 가능해요. 보증금 5억원에 월세 200만 원 조건으로도 조정이 가능하니 참고해 주세요.\n\n☎[phone removed] / [phone removed] \n선사현대아파트 정문앞 골목 크로바 부동산\n","addr":"서울시 강동구 상암로3길 77","jibun":"서울시 강동구 암사동 508","lat":37.554339,"lng":127.126947,"imgs":["https://d1774jszgerdmk.cloudfront.net/1024/3c9979b3-bcce-46dc-b73a-85bcef9517a9","https://d1774jszgerdmk.cloudfront.net/1024/59cf2b9b-9bcb-4d8a-b791-7c473ae45946","https://d1774jszgerdmk.cloudfront.net/1024/c170a538-005d-4274-9701-7549b593180b"],"facts":[["Exclusive size","114.87 m²"],["Supply size","148.82 m²"],["Rooms",4],["Bathrooms",2],["Floor","중층 of 26층"],["Facing","서"],["Layout","계단식"],["Parking","가능, 1.27 per unit"],["Move in","즉시 입주"],["Maintenance","25만원"],["Approved","2002.11.01"],["Households",490],["Posted","2026.10.14"]],"opts":[],"tags":["주차"],"near":[["서울선사초등학교","245 m"],["신암중학교","567 m"],["서울신암초등학교병설유치원","609 m"],["선사고등학교","814 m"]],"link":["Dabang","https://dabangapp.com/room/6acf35027e3dd10adb9fa64c"],"station":["암사역 (8호선)","469 m"]},"d:6ad56de541372846f99bdace":{"memo":"♣매물특징♣\n◆방3욕1\n◆햇살가득 밝은세대\n◆네모 반듯한 큰안방과 넓은거실\n\n※사전예약 부탁드립니다.\n\n고객님의 재산을 소중히 여기고 있는 \n서울시 종로구 창신동 창신역1번출구에 있는 \n창신부동산 입니다.\n저희 창신공인중개사사무소는 정직과 성실을 \n바탕으로 성심 성의껏 고객님께 좋은 정보를 \n제공하고 거래부동산을 법률적ㆍ경제적ㆍ\n기술적으로 분석하여 중개함으로써 무하자ㆍ\n무사고 중개, 문서에 의한 책임중개, 진정한 \n전문가중개 서비스를 통해서 고객님의 \n재산증식에 힘이 되어 드리겠습니다. \n감사합니다.","addr":"서울시 종로구 낙산길 198","jibun":"서울시 종로구 창신동 703","lat":37.580633,"lng":127.011747,"imgs":["https://d1774jszgerdmk.cloudfront.net/1024/6721d0ca-f66f-414c-b41b-900eb1fcf718","https://d1774jszgerdmk.cloudfront.net/1024/0038a612-11e7-4134-b1c2-7e6f74e69325","https://d1774jszgerdmk.cloudfront.net/1024/fa6874ab-6788-4c31-accc-25df44fdcdf4"],"facts":[["Exclusive size","79.87 m²"],["Supply size","108.01 m²"],["Rooms",3],["Bathrooms",1],["Floor","2층 of 15층"],["Facing","남서"],["Layout","복도식"],["Parking","가능, 0.5 per unit"],["Move in","즉시 입주"],["Maintenance","18만원"],["Approved","1993.10.12"],["Households",919],["Posted","2026.10.19"]],"opts":[],"tags":["주차"],"near":[["서울명신초등학교병설유치원","188 m"],["서울명신초등학교","249 m"],["서울동신초등학교병설유치원","526 m"],["서울창신초등학교병설유치원","540 m"]],"link":["Dabang","https://dabangapp.com/room/6ad56de541372846f99bdace"],"station":["창신역 (6호선)","311 m"]}}