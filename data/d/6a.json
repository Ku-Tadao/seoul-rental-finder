 한통이면 끝\n\n\n------- 📞 담당자  [phone removed]  --------","addr":"서울시 강남구 역삼로 532","jibun":"서울시 강남구 대치동 964","lat":37.50307,"lng":127.06064,"imgs":["https://d1774jszgerdmk.cloudfront.net/1024/9566c33d-13ac-488b-8946-a0c94eaa10e9","https://d1774jszgerdmk.cloudfront.net/1024/482c8732-4204-459b-bd45-c523d91d5203","https://d1774jszgerdmk.cloudfront.net/1024/b58fee85-2fc0-4a19-8690-cd90a081122c","https://d1774jszgerdmk.cloudfront.net/1024/dd740cb8-e779-4200-99f9-9ee307633dff"],"facts":[["Exclusive size","84.99 m²"],["Supply size","110.93 m²"],["Rooms",3],["Bathrooms",2],["Floor","고층 of 15층"],["Facing","남"],["Layout","계단식"],["Parking","가능, 1.69 per unit"],["Move in","즉시 입주"],["Maintenance","34만원"],["Approved","2025.08"],["Households",282],["Posted","2026.10.29"]],"opts":[],"tags":["주차"],"near":[["서울대현초등학교병설유치원","268 m"],["휘문중학교","293 m"],["서울대현초등학교","295 m"],["대명중학교","372 m"]],"link":["Dabang","https://dabangapp.com/room/6ae299d8f6a1796999b28d07"],"station":["삼성역 (2호선)","683 m"]},"d:6ad978c03654d8246a788912":{"memo":"생활편리한남향저층,도배해줌,우수학군단지,지하주차장","addr":"서울시 노원구 한글비석로 91","jibun":"서울시 노원구 하계동 251","lat":37.63958,"lng":127.071722,"imgs":["https://d1774jszgerdmk.cloudfront.net/1024/9cdbeb12-d7a6-4656-abac-4c73c1746c81","https://d1774jszgerdmk.cloudfront.net/1024/4aa55b10-fcb8-47d7-a9ae-1af02f384958","https://d1774jszgerdmk.cloudfront.net/1024/37f2962b-02d0-4569-82b7-dd43ef1d99ca"],"facts":[["Exclusive size","84.6 m²"],["Supply size","106.17 m²"],["Rooms",3],["Bathrooms",2],["Floor","1층 of 15층"],["Facing","남"],["Layout","계단식"],["Parking","가능, 1.11 per unit"],["Move in","2027.02.17"],["Maintenance","23만원"],["Approved","1997.06.27"],["Households",700],["Posted","2026.10.22"]],"opts":[],"tags":["주차","1층"],"near":[["하계중학교","177 m"],["혜성여자고등학교","209 m"],["서울용동초등학교병설유치원","286 m"],["대진고등학교","321 m"]],"link":["Dabang","https://dabangapp.com/room/6ad978c03654d8246a788912"],"station":["하계역 (7호선)","489 m"]},"d:6ad601ff600fe01ebd380044":{"memo":"공가,도배장판새로해줌,올수리,햇살좋은 남향,뻥뷰,로얄동 층입니다","addr":"