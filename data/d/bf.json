상됩니다.","addr":"서울시 서초구 서리풀길 28","jibun":"서울시 서초구 서초동 1612-2","lat":37.488899,"lng":127.020544,"imgs":["https://d1774jszgerdmk.cloudfront.net/1024/6bcd8eed-b824-4bf9-9b89-0b17243ca272"],"facts":[["Exclusive size","111.92 m²"],["Supply size","133.4 m²"],["Rooms",4],["Bathrooms",2],["Floor","중층 of 5층"],["Facing","남"],["Layout","복도식"],["Parking","가능, 1.4 per unit"],["Move in","즉시 입주"],["Maintenance","20만원"],["Approved","2002.09.23"],["Households",15],["Posted","2026.10.15"]],"opts":[],"tags":["주차"],"near":[["서초구립 서울교육대학교사향어린이집","331 m"],["서운중학교","671 m"],["서초중학교","1.1 km"],["서일중학교","1.2 km"]],"link":["Dabang","https://dabangapp.com/room/6ad03cd8312f8f5ea7b9aef3"],"station":["남부터미널역 (3호선)","550 m"]},"d:6acf3adc262592222135fdf5":{"memo":"- 서대문역 / 충정로역 도보3분 더블역세권\n- 주차장 없음\n- 엘레베이터, 경비실 있음","addr":"서울시 서대문구 충정로7길 9","jibun":"서울시 서대문구 충정로3가 189-8","lat":37.563295,"lng":126.964142,"imgs":["https://d1774jszgerdmk.cloudfront.net/1024/84556eff-977f-48ab-9f8f-4fcf2252c2e7"],"facts":[["Exclusive size","55.57 m²"],["Supply size","55.57 m²"],["Rooms",2],["Bathrooms",1],["Floor","중층 of 8층"],["Facing","서"],["Layout","복합식"],["Parking","불가능"],["Move in","2027.02.10"],["Maintenance","8만원"],["Approved","1969.06.13"],["Households",97],["Posted","2026.10.14"]],"opts":["벽걸이형","싱크대","가스레인지"],"tags":["보안/안전"],"near":[["서울미동초등학교","156 m"],["인창중학교","226 m"],["인창중학교","226 m"],["경기초등학교","241 m"]],"link":["Dabang","https://dabangapp.com/room/6acf3adc262592222135fdf5"],"station":["서대문역 (5호선)","351 m"]},"d:6ae41d0e4acb9021ba70566b":{"memo":"◆  대치공인중개사무소 ◆\n\n◆ ☎ [phone removed]   / 담당자 ) 소속 공인중개사 김성원 : [phone removed] ◆\n\n매물 설명은 전화주시면 친절히 설명해드리겠습니다.","addr":"경기도 성남시 수정구 수정로 319","jibun":"경기도 성남시 수정구 신흥동 6951","lat":37.45328,"lng":127.147565,"imgs":[],"facts":[["Exclusive size","74.96 m²"],["Supply size","96.59 m²"],["Rooms",3],["Bathrooms",2],["Floor","저층 of 28층"],["Facing","남"],["Layout","계단식"],["Parking","가능, 1.22 per unit"],["Move in","즉시 입주"],["Maintenance","29만원"],["Approved","2020.07.30"],["H